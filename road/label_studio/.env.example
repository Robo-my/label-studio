# Copy to .env and edit. Never put AWS keys here: road-captions uses the EC2 instance role.

POSTGRES_PASSWORD=change-me
LS_ADMIN_EMAIL=qa-lead@example.com
LS_ADMIN_PASSWORD=change-me-too
# The address the interns open. Also used as the trusted origin for logins.
PUBLIC_URL=http://localhost:8080
PORT=8080
LS_VERSION=1.23.2

# Bedrock model ID or inference profile ID, from your Bedrock console. Empty = template sentences only.
BEDROCK_MODEL_ID=
BEDROCK_REGION=ap-southeast-5

# true: the crop goes to Bedrock, so the model can describe it.
# A cross-region inference profile can process the crop outside Malaysia. Keep false if crops must stay.
SEND_IMAGE=false
# true: a rewrite from the intern's words also sends the crop (default: words and label only).
REWRITE_SENDS_IMAGE=false

BEDROCK_TIMEOUT_S=10
# Room for models that think before they answer. Output tokens are billed only when used.
BEDROCK_MAX_TOKENS=2048
# Optional JSON for model-specific fields (Converse additionalModelRequestFields). Check your model's docs.
BEDROCK_EXTRA_FIELDS=

# Only needed when task data holds raw s3:// paths that Label Studio does not resolve.
ALLOWED_S3_BUCKETS=
S3_REGION=ap-southeast-5

# Sentence requests per intern per minute.
RATE_PER_MIN=60
